// Aurora — FizzBuzz
// Demonstrates loops, nested conditionals, and the modulo operator.

fn fizzbuzz(limit) {
  i = 1 ;
  while i <= limit {
    if i % 15 == 0 {
      print "FizzBuzz" ;
    } else {
      if i % 3 == 0 {
        print "Fizz" ;
      } else {
        if i % 5 == 0 {
          print "Buzz" ;
        } else {
          print i ;
        }
      }
    }
    i = i + 1 ;
  }
}

fizzbuzz(15) ;
