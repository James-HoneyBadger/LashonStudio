10 REM FizzBuzz with WHILE and IF/ELSE
20 LET I = 1
30 WHILE I <= 15
40 IF I % 15 = 0 THEN PRINT "FIZZBUZZ"
50 IF I % 15 <> 0 THEN IF I % 3 = 0 THEN PRINT "FIZZ"
60 IF I % 15 <> 0 THEN IF I % 3 <> 0 THEN IF I % 5 = 0 THEN PRINT "BUZZ"
70 IF I % 15 <> 0 THEN IF I % 3 <> 0 THEN IF I % 5 <> 0 THEN PRINT I
80 LET I = I + 1
90 WEND
100 END
