// Aurora — recursive Fibonacci
// Demonstrates functions, conditionals, recursion, and arithmetic.

fn fib(n) {
  if n <= 1 { return n ; }
  return fib(n - 1) + fib(n - 2) ;
}

print "fib(10) =" ;
print fib(10) ;

fn fact(n) {
  if n <= 1 { return 1 ; }
  return n * fact(n - 1) ;
}

print "10! =" ;
print fact(10) ;
